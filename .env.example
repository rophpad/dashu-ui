# Required: read-only PostgreSQL database queried by Dashu.
DASHU_DATABASE_URL=postgres://readonly_user:password@localhost:5432/analytics

# Optional: PostgreSQL persistence for users, conversations, saved queries,
# dashboards and settings. Leave empty to use private JSON files in .dashu/.
DASHU_STORAGE_DATABASE_URL=

# Dashu Cloud endpoint and server-only credential for managed AI and Pro features.
DASHU_CLOUD_URL=https://dashu.vercel.app
DASHU_CLOUD_CREDENTIAL=
